# Production settings for deploy/vultr/docker-compose.yml. Copy to .env next to
# this file (chmod 600). Walkthrough in deploy/vultr/README.md.

# --- Hostnames (Cloudflare-proxied A records to this VPS) ---
APP_DOMAIN=app.next-role.dev
API_DOMAIN=api.next-role.dev

# --- Model + tool providers ---
ANTHROPIC_API_KEY=
LLAMA_CLOUD_API_KEY=
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TINYFISH_API_KEY=
# Traces include users' CV text; enable only if you will read them.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=next-role-prod

# --- Postgres (internal to the compose network) ---
POSTGRES_USER=next-role
POSTGRES_PASSWORD=             # generate: openssl rand -hex 24
POSTGRES_DB=next-role

# --- Login: Google only ---
BETTER_AUTH_SECRET=            # generate: openssl rand -base64 32
AUTH_GOOGLE_ENABLED=true
AUTH_EMAIL_PASSWORD_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# --- Model lock: every run uses the defaults (claude-sonnet-5-5) ---
MODEL_OVERRIDE_ENABLED=false

# --- Usage quotas (rolling windows; 0 disables a limit) ---
QUOTA_RUNS_PER_DAY=10
QUOTA_RUNS_PER_WEEK=30
QUOTA_USD_PER_DAY=1.5
QUOTA_USD_PER_WEEK=4
QUOTA_GLOBAL_USD_PER_DAY=3
QUOTA_MAX_CONCURRENT_RUNS=1

# --- Artifacts: Cloudflare R2 (S3 API) ---
OBJECT_STORE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORE_BUCKET=next-role-artifacts
OBJECT_STORE_REGION=auto
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_FORCE_PATH_STYLE=true

# --- Agent shell: none (no execute tool) ---
SANDBOX_PROVIDER=none
