<!-- Dev-box tuning: keep the single-node warehouse comfortably inside the
     compose mem_limit (ClickHouse reads the cgroup limit, so the ratio applies
     to the container cap, not host RAM). System-log tables that exist purely
     for cluster observability are disabled — they are the biggest idle
     memory/disk consumers on a laptop deployment. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <trace_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <processors_profile_log remove="remove"/>
</clickhouse>
