{
  "cubes": [
    {
      "name": "runs",
      "type": "cube",
      "description": "One row per agent run.",
      "meta": {
        "grain": "one run",
        "caveats": ["'interrupted' means paused for approval - not a failure"]
      },
      "measures": [
        {
          "name": "runs.success_rate",
          "type": "number",
          "description": "Share of runs that succeeded.",
          "meta": {"formula": "success_count / count"}
        }
      ],
      "dimensions": [
        {"name": "runs.owner", "type": "string", "description": "Owning user.", "meta": {"synonyms": ["user"]}}
      ]
    },
    {
      "name": "overview",
      "type": "view",
      "description": "The headline questions.",
      "meta": {"example_questions": ["How many users were active this week?", "What is the p95 duration?"]},
      "measures": [],
      "dimensions": []
    }
  ]
}
