                <mxCell id="r9a" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;ellipse;opacity=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1684" y="869" width="2" height="2" as="geometry"/>
                </mxCell>
                <mxCell id="r9b" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;ellipse;opacity=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="784" y="869" width="2" height="2" as="geometry"/>
                </mxCell>
                <mxCell id="r9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;strokeWidth=2;strokeColor=#496987;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;endArrow=block;endSize=8;" parent="1" source="r9a" target="r9b" edge="1" data-source="backend/ARCHITECTURE.md">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r9text" value="9  Publish events; MarkDone / lifecycle transition" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="797" y="837" width="876" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="run-idle" value="&lt;b&gt;Idle + retry behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;No pending row → core-server BLPOP waits up to 5s, then retries SQL. Redis is a doorbell, not the queue. Retriable errors re-pend runs; retry counters live in Redis." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="980" width="850" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="run-limits" value="&lt;b&gt;Operational limits&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exactly one cron process. No orphan-run sweeper: SIGKILL / OOM can strand a running row. Fargate drain settings must be reconciled with the 180s application default." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="960" y="980" width="880" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
