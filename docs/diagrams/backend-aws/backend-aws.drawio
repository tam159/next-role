                </mxCell>
                <mxCell id="deployment-caveats" value="&lt;b&gt;Deployment details to resolve&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fargate stopTimeout ≤120s: shorten the 180s application drain with headroom, or choose ECS on EC2.&lt;br&gt;Use explicit gRPC service routing; DNS alone does not prove per-RPC load balancing. External LLM / analytics endpoints and egress are omitted." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
