                <mxCell id="truth" value="&lt;b&gt;Durability boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Postgres is the system of record. S3 holds binaries. Redis loss removes live events and bounded replay, not pending runs or saved graph state." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="750" width="570" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="ownership-legend" value="Solid = service / artifact path     ·     Dashed = database path that bypasses gRPC" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="450" y="1040" width="1250" height="35" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
