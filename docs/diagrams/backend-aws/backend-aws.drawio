                <mxCell id="r7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;strokeWidth=2;strokeColor=#496987;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;endArrow=block;endSize=8;" parent="1" source="r7a" target="r7b" edge="1" data-source="backend/ARCHITECTURE.md">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r7text" value="7  Claimed run + persisted identity" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="797" y="707" width="876" height="28" as="geometry"/>
                </mxCell>
