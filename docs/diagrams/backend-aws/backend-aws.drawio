                <mxCell id="s9text" value="9  Reconnect with last_event_id → repeat replay + live" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=14;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="197" y="837" width="276" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="stream-bounds" value="&lt;b&gt;Bounded replay&lt;/b&gt;&lt;br&gt;&lt;br&gt;~8192 structural entries / 7-day TTL. Tools, values, lifecycle and control are logged; token/tool-argument chunks are live-only. Final state rehydrates from Postgres beyond replay bounds." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="980" width="880" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="stream-roles" value="&lt;b&gt;Roles, not extra services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Publisher and subscriber may be different core-server replicas of the same service. Cancellation uses a :control channel plus a 60s key to cover the subscribe race." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172B4D;rounded=1;arcSize=10;fillColor=#F3F6FA;strokeColor=#D6E0EB;align=left;verticalAlign=middle;spacing=18;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="990" y="980" width="850" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
